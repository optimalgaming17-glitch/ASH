<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="ASHMASTER.Master.cs" Inherits="iot.Site2" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mater Page ASH</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="DashBoard.css" rel="stylesheet" />
    <link href="DashBoard2.css" rel="stylesheet" />
    <link href="Loader.css" rel="stylesheet" />
    <link href="Footer.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <div id="loader">

            <lottie-player
                src="https://assets2.lottiefiles.com/packages/lf20_2LdLki.json"
                background="transparent"
                speed="1"
                style="width: 120px; height: 120px;"
                loop
                autoplay>
            </lottie-player>

            <p>SMARTNING YOUR HOME...</p>
        </div>

            <aside class="sidebar">

                <div class="logo">
                  <h2>ASH</h2>
                  <p>INNOVATIES</p>
                </div>

       
                <ul>

                    <li class="active">

                        <i class="bi bi-grid-fill"></i>
                        <a href="DashBoard.aspx" style="text-decoration: none"><span>DashBoard</span></a>

                    </li>

                    <li>

                        <i class="bi bi-lightbulb-fill"></i>
                        <a href="SmartBulb.aspx" style="text-decoration: none"><span>Smart Bulb</span></a>

                    </li>

                    <li>

                        <i class="bi bi-thermometer-half"></i>
                        <a href="Temperature.aspx" style="text-decoration: none"><span>Temperature</span></a>

                    </li>

                    <li>

                        <i class="bi bi-cloud-haze2-fill"></i>
                        <a href="Smoke.aspx" style="text-decoration: none"><span>Smoke</span></a>

                    </li>

                    <li>

                        <i class="bi bi-person-walking"></i>
                        <a href="Motion.aspx" style="text-decoration: none"><span>Motion</span></a>


                    </li>

                    <li>

                        <i class="bi bi-bar-chart-fill"></i>
                        <a href="Report.aspx" style="text-decoration: none"><span>Report</span></a>


                    </li>

                    <li>

                        <i class="bi bi-robot"></i>
                        <a href="AI.aspx" style="text-decoration: none"><span>AI Assistant</span></a>

                    </li>

                    <li>

                        <i class="bi bi-gear-fill"></i>
                        <a href="Setting.aspx" style="text-decoration: none"><span>Settings</span></a>


                    </li>

                    <li>

                        <i class="bi bi-person-circle"></i>
                        <a href="Profile.aspx" style="text-decoration: none"><span>Profile</span></a>


                    </li>

                </ul>
          
            </aside>

            <div class="main-content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
              </div>
                <div class="footer-wrapper">
    <footer class="smart-footer">

    <div class="footer-main">

        <!-- Brand -->
        <div class="footer-brand">
            
                     <img class="brand-logo" src="Images/ChatGPT Image Jul 30, 2026, 11_37_34 PM.png" />
           
            <p style="margin-top:5px;">
                Smart Home Automation System to make your
                home safe, smart and energy efficient.
            </p>

            <div class="social-links">
                <a href="#">f</a>
                <a href="#">𝕏</a>
                <a href="#">◎</a>
                <a href="#">▶</a>
            </div>
        </div>


        <!-- Product -->
        <div class="footer-column">
            <h3>PRODUCT</h3>

            <a href="#">Dashboard</a>
            <a href="#">Devices</a>
            <a href="#">Automation</a>
            <a href="#">Schedules</a>
            <a href="#">Analytics</a>
        </div>


        <!-- System -->
        <div class="footer-column">
            <h3>SYSTEM</h3>

            <a href="#">Device Status</a>
            <a href="#">Sensor Logs</a>
            <a href="#">Energy Monitor</a>
            <a href="#">API Status</a>
            <a href="#">Notifications</a>
        </div>


        <!-- Support -->
        <div class="footer-column">
            <h3>SUPPORT</h3>

            <a href="#">Help Center</a>
            <a href="#">Documentation</a>
            <a href="#">Contact Us</a>
            <a href="#">Report an Issue</a>
            <a href="#">Feedback</a>
        </div>


        <!-- Stay Connected -->
        <div class="footer-connect">

            <h3>STAY CONNECTED</h3>

            <div class="email-box">
                <asp:TextBox runat="server" CssClass="email-box_input" ID="txtEmail" TextMode="SingleLine" Text="Enter message for us"></asp:TextBox>
                <asp:Button runat="server" cssClass="email-box_button" Text="➤" OnClick="sendMail"></asp:Button>
            </div>

            <p>
                Get alerts and updates about your
                home and system.
            </p>

        </div>

    </div>

    <!-- Bottom -->
    <div class="footer-bottom">

        <span>
            © 2026 SmartHome Automation System
        </span>

        <span>
            Powered by
            <b>Team ASH</b>
            <i>•</i>
            <b>MARK TEAM</b>
            <i>•</i>
            <b>ASH Server</b>
        </span>

    </div>

</footer>
                  

            </div>     
        </form> 

   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
   <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
   <script src="DashBoard.js"></script>
   <script src="DashBoard2.js"></script>
   
    

     <script>

     window.onload = function () {
         setTimeout(function () {
             document.getElementById("loader").style.display = "none";
         }, 1800);
};
      
     </script>


</body>
</html>
